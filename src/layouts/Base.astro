---
import WaIcon from '../components/WaIcon.astro';
import '../styles/global.css';
import { strings, path, typo, CONTACT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path without the /en prefix, e.g. '/' or '/work/repair-ninja/'. */
  route: string;
  noindex?: boolean;
  jsonld?: object[];
  bodyClass?: string;
}
const { lang, title, description, route, noindex = false, jsonld = [], bodyClass } = Astro.props;
const s = strings(lang);
const site = Astro.site!;
const frUrl = new URL(path(route, 'fr'), site).href;
const enUrl = new URL(path(route, 'en'), site).href;
const canonical = lang === 'fr' ? frUrl : enUrl;
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const home = path('/', lang);

const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': new URL('/#studio', site).href,
  name: 'esPAce',
  description: strings('fr').meta.description,
  url: new URL('/', site).href,
  email: CONTACT.email,
  telephone: CONTACT.phone,
  areaServed: 'Worldwide',
  address: { '@type': 'PostalAddress', addressLocality: 'Paris', addressCountry: 'FR' },
  knowsLanguage: ['fr', 'en'],
  founder: {
    '@type': 'Person',
    name: CONTACT.name,
    jobTitle: lang === 'fr' ? 'Designer web et ingénieur IA et données' : 'Web designer and AI & data engineer',
    sameAs: [CONTACT.linkedin, CONTACT.github],
  },
  makesOffer: strings(lang).packages.items.map((p) => ({
    '@type': 'Offer',
    name: p.name,
    description: p.body,
    priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'EUR', minPrice: Number(p.price.replace(/[^\d]/g, '')) },
  })),
};
const ld = [business, ...jsonld];
---
<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{typo(title, lang)}</title>
    <meta name="description" content={typo(description, lang)} />
    <link rel="canonical" href={canonical} />
    {!noindex && <link rel="alternate" hreflang="fr" href={frUrl} />}
    {!noindex && <link rel="alternate" hreflang="en" href={enUrl} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={frUrl} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F5F3EE" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141615" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo-display.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="esPAce" />
    <meta property="og:title" content={typo(title, lang)} />
    <meta property="og:description" content={typo(description, lang)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', site).href} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function (h) {
        h.classList.replace('no-js', 'js');
        try { var t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') h.dataset.theme = t; } catch (e) {}
      })(document.documentElement);
    </script>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body class={bodyClass}>
    <span id="top" tabindex="-1"></span>
    <a class="skip" href="#contact">{s.nav.skip}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="plaque" href={home} aria-label={s.nav.home}><span>esPAce</span></a>
        <nav class="site-nav" aria-label="Principal">
          <a href={`${home}#travaux`}>{s.nav.work}</a>
          <a href={`${home}#offres`}>{s.nav.offers}</a>
          <a href={`${home}#apropos`}>{s.nav.about}</a>
          <a href={`${home}#contact`}>{s.nav.contact}</a>
        </nav>
        <div class="tools">
          <nav class="langs" aria-label={s.nav.langLabel}>
            <a href={path(route, 'fr')} hreflang="fr" lang="fr" aria-current={lang === 'fr' ? 'true' : undefined}>FR</a>
            <a href={path(route, 'en')} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
          </nav>
          <button class="theme-toggle" type="button" aria-label={s.nav.theme} data-theme-toggle>
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg>
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/></svg>
          </button>
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu">{s.nav.menu}</button>
        </div>
      </div>
    </header>
    <div class="menu-panel" id="menu" hidden>
      <div class="row">
        <a class="plaque" href={home} aria-label={s.nav.home}><span>esPAce</span></a>
        <button class="menu-toggle" type="button" data-close>{s.nav.close}</button>
      </div>
      <nav aria-label="Menu">
        <a href={`${home}#travaux`}>{s.nav.work}</a>
        <a href={`${home}#offres`}>{s.nav.offers}</a>
        <a href={`${home}#apropos`}>{s.nav.about}</a>
        <a href={`${home}#contact`}>{s.nav.contact}</a>
      </nav>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>© {new Date().getFullYear()} esPAce · Walid Birouk</p>
        <p>{typo(s.footer.area, lang)}</p>
        <a href={CONTACT.linkedin} rel="noopener">LinkedIn</a>
      </div>
    </footer>
    <a class="wa-fab" href={CONTACT.whatsapp} rel="noopener" target="_blank" aria-label="WhatsApp"><WaIcon size={28} /></a>
    <a class="to-top" href="#top" aria-label={s.nav.top} data-to-top>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5"/></svg>
    </a>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
