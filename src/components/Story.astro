---
// Customer story as a journey (after myrak.ch/methode): one line snakes from the title's full stop, behind each phone,
// to the closing line. It draws as you scroll; a dot rides its tip; the step in the middle of the window lights up;
// the line merges into the final dot. Desktop: copy and phone alternate sides. Phone: the line runs down the left.
// Reduced motion: the line is drawn in full, nothing moves. Logic in scripts/journey.ts.
import { strings, typo, CONTACT, type Lang } from '../i18n';
import StoryScreen from './StoryScreen.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = strings(lang).story;
const t = (x: string) => typo(x, lang);
const booking = CONTACT.booking || '#contact';
// The full stop of the title becomes the dot the line starts from (and the closing one, where it ends).
const dotless = (x: string) => t(x).replace(/\s*\.$/, '');
const stepId = (i: number) => `${lang === 'fr' ? 'etape' : 'step'}-${i + 1}`;
---
<section class="story section" id="parcours" aria-labelledby="story-title" data-story>
  <svg class="story__line" data-journey-line aria-hidden="true" focusable="false">
    <path class="story__ghost" data-line-ghost />
    <path class="story__progress" data-line-progress />
    <circle class="story__tip" data-line-dot r="8" cx="-20" cy="-20" />
  </svg>

  <div class="wrap story__head">
    <h2 id="story-title" class="display-l"><span>{dotless(s.title)}</span><i class="story__dot" data-journey-start aria-hidden="true"></i></h2>
    {s.intro && <p class="lead">{t(s.intro)}</p>}
    {s.cue && <a class="story__cue" href={`#${stepId(0)}`}>{t(s.cue)} <span aria-hidden="true">↓</span></a>}
  </div>

  <ol class="wrap story__beats">
    {s.beats.map((b, i) => (
      <li class:list={['story__beat', { 'story__beat--right': i % 2 === 1 }]} id={stepId(i)} data-beat={i}>
        <span class="story__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <div class="story__copy">
          <p class="story__time">{t(b.time)}</p>
          <h3 class="heading">{t(b.title)}</h3>
          <p class="story__body">{t(b.body)}</p>
          <p class="story__do"><b>{s.doLabel}</b>{t(b.do)}</p>
        </div>
        <div class="story__phone" data-journey-anchor>
          <div class="mobile__frame"><div class="mobile__screen"><StoryScreen id={b.id} lang={lang} /></div></div>
        </div>
      </li>
    ))}
  </ol>

  <div class="wrap story__end">
    <p class="display-l"><span>{dotless(s.endTitle)}</span><i class="story__dot story__dot--end" data-journey-end aria-hidden="true"></i></p>
    <p class="lead">{t(s.endBody)}</p>
    <p><a class="btn" href={booking} target={CONTACT.booking ? '_blank' : undefined} rel="noopener">{s.cta}</a></p>
  </div>
</section>

<script>
  import { journey } from '../scripts/journey';
  const root = document.querySelector<HTMLElement>('[data-story]');
  if (root && 'IntersectionObserver' in window) {
    journey(root);
    // Each phone screen plays out (typing, pins, cards, counters) when most of it is on screen.
    const motion = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fmt = new Intl.NumberFormat(document.documentElement.lang || 'fr');
    const timers = new WeakMap<HTMLElement, number[]>();
    const play = (scr: HTMLElement | null) => {
      if (!scr || !motion || scr.classList.contains('is-play')) return;
      (timers.get(scr) ?? []).forEach(clearTimeout);
      const ids: number[] = [];
      scr.querySelectorAll<HTMLElement>('[data-type]').forEach((el) => {
        const full = el.dataset.type!;
        el.textContent = '';
        [...full].forEach((_, k) => ids.push(window.setTimeout(() => { el.textContent = full.slice(0, k + 1); }, 250 + k * 42)));
      });
      scr.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        const end = Number(el.dataset.count), pre = el.dataset.prefix ?? '', suf = el.dataset.suffix ?? '';
        const delay = 500, dur = 1100;
        el.textContent = `${pre}0${suf}`;
        ids.push(window.setTimeout(() => {
          const t0 = performance.now();
          const tick = (now: number) => {
            const p = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - p, 3);
            el.textContent = `${pre}${fmt.format(Math.round(end * e))}${suf}`;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }, delay));
      });
      timers.set(scr, ids);
      scr.classList.add('is-play');
      scr.closest('[data-beat]')?.classList.add('is-played');
    };
    if (motion) root.querySelectorAll<HTMLElement>('.scr').forEach((scr) => scr.classList.add('is-armed'));
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) { io.unobserve(e.target); play(e.target.querySelector('.scr')); } }),
      { threshold: 0.45 },
    );
    root.querySelectorAll('.story__phone').forEach((el) => io.observe(el));
    // The title's dot pops once the title is on screen.
    const head = root.querySelector('.story__head');
    if (head) new IntersectionObserver((en, o) => { if (en.some((e) => e.isIntersecting)) { root.classList.add('is-seen'); o.disconnect(); } }, { threshold: 0.4 }).observe(head);
  }
</script>

<style>
  .story { position: relative; isolation: isolate; }
  .story__line { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .story__ghost { fill: none; stroke: var(--zinc); stroke-width: 2; stroke-dasharray: 7 13; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .story__progress { fill: none; stroke: var(--enamel); stroke-width: 3; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .story__tip { fill: var(--enamel); stroke: var(--paper); stroke-width: 3; opacity: 0; transition: opacity .3s ease; }
  .story__line { transition: opacity .5s ease, filter .5s ease; }
  .story.is-complete .story__line { opacity: 0; filter: blur(2px); }

  .story__head, .story__beats, .story__end { position: relative; z-index: 1; }
  .story__head { display: grid; gap: var(--space-3); margin-bottom: var(--space-5); }
  .story__head h2 span { position: relative; }
  .story__dot { display: inline-block; width: .17em; height: .17em; margin-left: .06em; border-radius: 50%; background: var(--enamel); vertical-align: 0; scale: 0; }
  .story.is-seen .story__dot, .story__dot--end { scale: 1; }
  .story__dot--end { transition: scale .6s var(--ease-story), box-shadow .6s var(--ease-story); }
  .story__dot--end.is-merged { scale: 1.25; box-shadow: 0 0 0 .14em color-mix(in srgb, var(--enamel) 18%, transparent); }
  .story__cue { display: inline-flex; gap: .5em; width: max-content; color: var(--enamel); font-weight: 600; font-size: var(--fs-caption); text-decoration: none; }
  .story__cue span { transition: translate .3s var(--ease-story); }
  .story__cue:hover span { translate: 0 3px; }

  .story__beats { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-6, 64px); }
  .story__beat { position: relative; display: grid; gap: var(--space-4); scroll-margin-top: 96px; }
  .story__num {
    position: absolute; z-index: 0; top: -.18em; left: -.03em; line-height: .78; pointer-events: none; user-select: none;
    font-family: var(--font-display); font-weight: 750; font-stretch: var(--stretch-xl); font-size: clamp(104px, 22vw, 176px); letter-spacing: -.04em;
    color: var(--ink); opacity: .11; transform: scale(.92); transform-origin: left top;
    transition: color .4s ease, opacity .4s ease, text-shadow .5s ease, transform .6s var(--ease-story);
  }
  .story__beat.is-in-view .story__num { color: var(--enamel); opacity: 1; transform: scale(1); text-shadow: 0 0 14px color-mix(in srgb, var(--enamel) 28%, transparent), 0 0 40px color-mix(in srgb, var(--enamel) 18%, transparent); }
  .story__copy {
    position: relative; z-index: 2; display: grid; gap: var(--space-2); padding: var(--space-4);
    background: var(--paper-raised); border: 1px solid var(--zinc); border-radius: var(--radius-paper); box-shadow: var(--shadow-paper), inset 0 -4px 0 var(--enamel);
  }
  .story__copy h3 { margin: 0; }
  .story__copy p { margin: 0; }
  .story__time { font-family: var(--font-display); font-stretch: 80%; font-weight: 600; color: var(--enamel); }
  .story__body { font-size: var(--fs-lead); line-height: 1.4; }
  .story__do { padding-top: var(--space-2); margin-top: var(--space-1); border-top: 1.5px solid var(--ink); color: var(--graphite); }
  .story__do b { display: block; color: var(--enamel); font-weight: 600; }
  .story__phone {
    position: relative; z-index: 2; width: min(100%, 250px); justify-self: center;
    rotate: var(--tilt, -1.6deg); translate: 0 0; box-shadow: var(--shadow-paper); border-radius: 22px;
    transition: rotate .8s var(--ease-story), translate .8s var(--ease-story), box-shadow .8s var(--ease-story);
  }
  .story__beat--right .story__phone { --tilt: 1.6deg; }
  .story__beat.is-in-view .story__phone, .story__beat:hover .story__phone { rotate: 0deg; translate: 0 -6px; box-shadow: 0 1px 1px rgba(28,30,29,.06), 0 30px 60px -20px rgba(28,30,29,.28); }
  .story__end { margin-top: var(--space-6, 64px); display: grid; gap: var(--space-3); }

  @media (max-width: 899px) {
    .story__head, .story__beats, .story__end { padding-left: calc(var(--space-3) + 34px); }
    .story__beat { padding-top: calc(var(--space-5) + 28px); }
    .story__num { top: 0; font-size: 104px; }
    .story__phone { justify-self: end; width: min(78%, 250px); margin-right: 4%; }
  }
  @media (min-width: 900px) {
    .story__head { margin-bottom: var(--space-6, 64px); }
    .story__beat { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: 1fr; align-items: center; min-height: 640px; padding: var(--space-5) 0; }
    .story__copy { grid-column: 1 / 7; grid-row: 1; padding: var(--space-5); }
    .story__phone { grid-column: 8 / 13; grid-row: 1; width: 270px; }
    .story__beat--right .story__copy { grid-column: 7 / 13; }
    .story__beat--right .story__phone { grid-column: 1 / 6; }
    .story__num { top: -.1em; left: 0; }
    .story__beat--right .story__num { left: auto; right: 0; transform-origin: right top; }
    .story__end { margin-top: var(--space-6, 64px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .story__num, .story__phone, .story__dot--end, .story__line, .story__cue span { transition: none; }
    .story__phone { rotate: 0deg; }
    .story__dot { scale: 1; }
    .story.is-complete .story__line { opacity: 1; filter: none; }
  }
</style>
