---
// The campaign piece of a project (search ad, social ad or assistant chat), with how it is set up.
// Mock-ups stay light in dark mode, like the real screens they stand for.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { tr, typo, type Lang } from '../i18n';

interface Props { project: CollectionEntry<'projects'>; lang: Lang }
const { project, lang } = Astro.props;
const p = project.data;
const sc = p.showcase!;
const fr = lang === 'fr';
const accent = p.palette[0].hex;
const ink = p.palette.at(-1)!.hex;
const L = {
  sponsored: fr ? 'Sponsorisé' : 'Sponsored',
  setup: fr ? 'Le réglage' : 'The setup',
  note: p.kind === 'client'
    ? (fr ? 'Exemple de conversation, réécrit à partir des échanges habituels.' : 'Example conversation, rewritten from typical exchanges.')
    : fr
      ? 'Commerce imaginé : tout est réglé pour l’exemple, sans résultats inventés.'
      : 'Invented business: everything is set up for the example, with no invented results.',
  assistant: fr ? 'Assistant de la boutique' : 'Shop assistant',
  you: fr ? 'Vous' : 'You',
};
---
<section class="section wrap showcase" aria-labelledby="w-showcase" style={`--sc-accent:${accent};--sc-ink:${ink}`}>
  <h2 id="w-showcase" class="display-l">{tr(sc.title, lang)}</h2>
  <div class="showcase__grid">
    <figure class="mat showcase__mock">
      {sc.kind === 'search' && (
        <div class="serp">
          <div class="serp__bar"><span>{tr(sc.query, lang)}</span></div>
          <div class="serp__ad">
            <p class="serp__meta"><b>{L.sponsored}</b> <span>{sc.url}</span></p>
            <p class="serp__title">{tr(sc.headline, lang)}</p>
            <p class="serp__desc">{tr(sc.description, lang)}</p>
            <ul class="serp__links">{sc.sitelinks.map((l) => <li>{tr(l, lang)}</li>)}</ul>
          </div>
          <div class="serp__ghost" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="serp__ghost" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>
      )}
      {sc.kind === 'social' && (
        <div class="post">
          <p class="post__head"><span class="post__avatar"></span><span><b>{sc.handle}</b><br /><small>{L.sponsored}</small></span></p>
          <Image src={p.fragments[sc.image].src} alt={tr(p.fragments[sc.image].alt, lang)} widths={[480, 720]} sizes="(min-width: 900px) 30vw, 90vw" loading="lazy" />
          <p class="post__cta"><span>{tr(sc.cta, lang)}</span><span aria-hidden="true">›</span></p>
          <p class="post__text"><b>{sc.handle}</b> {tr(sc.text, lang)}</p>
        </div>
      )}
      {sc.kind === 'chat' && (
        <div class="chat">
          <p class="chat__head"><span class="post__avatar"></span><b>{p.name}</b><small>{L.assistant}</small></p>
          <ol class="chat__list">
            {sc.messages.map((m) => (
              <li class={`chat__msg chat__msg--${m.from}`}><span class="sr-only">{m.from === 'user' ? L.you : L.assistant}{fr ? ' :' : ':'} </span>{tr(m.text, lang)}</li>
            ))}
          </ol>
        </div>
      )}
    </figure>
    <div class="stack">
      <h3 class="heading">{L.setup}</h3>
      <dl class="showcase__plan">
        {sc.plan.map((row) => (<div><dt>{tr(row.label, lang)}</dt><dd>{tr(row.value, lang)}</dd></div>))}
      </dl>
      <p class="caption">{typo(L.note, lang)}</p>
    </div>
  </div>
</section>

<style>
  .showcase { display: flex; flex-direction: column; gap: var(--space-5); }
  .showcase__grid { display: grid; gap: var(--space-5); align-items: start; }
  @media (min-width: 900px) { .showcase__grid { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: var(--space-6); } }
  .showcase__mock { margin: 0; padding: clamp(16px, 3vw, 40px); background: #E9EBE6; color: #1F2328; font-family: Arial, Helvetica, sans-serif; }
  .showcase__plan { margin: 0; display: grid; }
  .showcase__plan div { display: grid; grid-template-columns: minmax(6.5em, 9em) 1fr; gap: var(--space-3); padding: 12px 0; border-top: 1px solid var(--zinc); }
  .showcase__plan dt { color: var(--graphite); }
  .showcase__plan dd { margin: 0; }

  .serp { background: #fff; border-radius: 12px; padding: 20px; display: grid; gap: 22px; box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 8px 24px rgba(0,0,0,.06); }
  .serp__bar { border: 1px solid #DADCE0; border-radius: 999px; padding: 10px 18px; font-size: 16px; }
  .serp__ad { display: grid; gap: 4px; }
  .serp__meta { margin: 0; font-size: 13px; color: #4D5156; } .serp__meta b { color: #1F2328; margin-right: 6px; }
  .serp__title { margin: 0; font-size: 20px; line-height: 1.3; color: #1A0DAB; }
  .serp__desc { margin: 0; font-size: 14px; line-height: 1.55; color: #4D5156; }
  .serp__links { list-style: none; margin: 6px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 6px 16px; font-size: 14px; color: #1A0DAB; }
  .serp__ghost { display: grid; gap: 7px; } .serp__ghost i { display: block; height: 9px; border-radius: 4px; background: #ECEDEF; }
  .serp__ghost i:first-child { width: 38%; height: 13px; background: #E3E6F4; } .serp__ghost i:last-child { width: 72%; }

  .post { background: #fff; border-radius: 10px; overflow: hidden; max-width: 420px; margin-inline: auto; box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 8px 24px rgba(0,0,0,.06); font-size: 14px; line-height: 1.45; }
  .post__head { margin: 0; display: flex; gap: 10px; align-items: center; padding: 10px 12px; } .post__head small { color: #65676B; }
  .post__avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--sc-accent); box-shadow: inset 0 0 0 3px #fff, 0 0 0 1.5px var(--sc-accent); flex: none; }
  .post :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4/5; object-fit: cover; }
  .post__cta { margin: 0; display: flex; justify-content: space-between; padding: 11px 12px; background: var(--sc-ink); color: #fff; font-weight: 700; }
  .post__text { margin: 0; padding: 10px 12px 14px; }

  .chat { background: #fff; border-radius: 12px; max-width: 460px; margin-inline: auto; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 8px 24px rgba(0,0,0,.06); }
  .chat__head { margin: 0; display: flex; gap: 10px; align-items: center; padding: 12px 14px; border-bottom: 1px solid #ECEDEF; } .chat__head { flex-wrap: wrap; } .chat__head small { margin-left: auto; color: #65676B; }
  .chat__list { list-style: none; margin: 0; padding: 16px 14px 20px; display: flex; flex-direction: column; gap: 10px; font-size: 15px; line-height: 1.45; }
  .chat__msg { max-width: 82%; padding: 9px 13px; border-radius: 16px; }
  .chat__msg--user { align-self: flex-end; background: var(--sc-ink); color: #fff; border-bottom-right-radius: 4px; }
  .chat__msg--bot { align-self: flex-start; background: #F1F2F4; border-bottom-left-radius: 4px; }
</style>
